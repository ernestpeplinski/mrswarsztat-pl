---
import Section from '../ui/Section.astro';
import Icon from '../icons/Icon.astro';
import { FAQ } from '../../config/faq';
---

<Section
  id="faq"
  eyebrow="FAQ"
  title="Najczęstsze pytania"
  intro="Krótko o dojeździe, godzinach i umawianiu wizyty."
>
  <div class="max-w-3xl divide-y divide-line rounded-2xl border border-line bg-ink-2">
    {
      FAQ.map(({ question, answer }) => (
        <details class="group p-5 sm:p-6">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-bold [&::-webkit-details-marker]:hidden">
            <h3 class="text-lg font-bold">{question}</h3>
            <span class="shrink-0 text-brand transition-transform group-open:rotate-90" aria-hidden="true">
              <Icon name="arrow-right" size={20} />
            </span>
          </summary>
          <p class="mt-3 text-cream/80">{answer}</p>
        </details>
      ))
    }
  </div>
</Section>
