---
import { Image } from 'astro:assets';
import Icon from '../icons/Icon.astro';
import logo from '../../assets/images/mrs-logo.png';
import { NAV, SITE } from '../../config/site';
import { url } from '../../utils/url';

const year = new Date().getFullYear();

const social = [
  { label: 'Facebook', icon: 'facebook', href: SITE.social.facebook },
  { label: 'Instagram', icon: 'instagram', href: SITE.social.instagram },
  { label: 'TikTok', icon: 'tiktok', href: SITE.social.tiktok },
] as const;

const heading = 'text-xs font-bold tracking-wider text-muted uppercase';
const link = 'transition-colors hover:text-white';
---

<footer class="border-t-2 border-brand bg-ink-2">
  <div class="mx-auto max-w-6xl px-4 pt-8 pb-6 sm:px-6">
    <!-- Trzy wyśrodkowane kolumny: marka + adres | kontakt | social media -->
    <div class="grid gap-8 text-center md:grid-cols-3 md:items-start">
      <div class="flex flex-col items-center">
        <a href={url('/')} aria-label={`${SITE.name} – strona główna`}>
          <Image
            src={logo}
            alt={`Logo ${SITE.name}`}
            width={160}
            height={160}
            loading="lazy"
            class="logo-fade h-20 w-20"
          />
        </a>
        <address class="mt-3 text-sm text-cream/80 not-italic">
          <a
            href={SITE.directionsUrl}
            target="_blank"
            rel="noopener"
            class={`inline-flex items-center gap-2 ${link}`}
          >
            <Icon name="map-pin" size={18} class="shrink-0 text-brand" />
            <span class="text-center">
              {SITE.address.street}<br />
              {SITE.address.postalCode} {SITE.address.locality}
            </span>
          </a>
        </address>
      </div>

      <div class="flex flex-col items-center">
        <p class={heading}>Kontakt</p>
        <ul class="mt-3 flex flex-col items-center gap-2 text-sm text-cream/80">
          {
            SITE.phones.map((phone) => (
              <li>
                <a href={phone.href} class={`inline-flex items-center gap-2 ${link}`}>
                  <Icon name="phone" size={18} class="shrink-0 text-brand" />
                  {phone.display}
                </a>
              </li>
            ))
          }
          <li>
            <a href={`mailto:${SITE.email}`} class={`inline-flex items-center gap-2 ${link}`}>
              <Icon name="mail" size={18} class="shrink-0 text-brand" />
              {SITE.email}
            </a>
          </li>
          <li class="inline-flex items-center gap-2">
            <Icon name="clock" size={18} class="shrink-0 text-brand" />
            {SITE.hours.label}
          </li>
        </ul>
      </div>

      <div class="flex flex-col items-center">
        <p class={heading}>Obserwuj nas</p>
        <ul class="mt-3 flex gap-3">
          {
            social.map((item) => (
              <li>
                <a
                  href={item.href}
                  target="_blank"
                  rel="noopener me"
                  aria-label={item.label}
                  title={item.label}
                  class="flex h-11 w-11 items-center justify-center rounded-full border border-line bg-ink text-cream transition-colors hover:border-brand hover:bg-brand hover:text-white"
                >
                  <Icon name={item.icon} size={22} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Linki wewnętrzne w jednym rzędzie -->
    <nav aria-label="Stopka" class="mt-8 border-t border-line pt-5">
      <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-cream/80">
        {
          NAV.map((item) => (
            <li>
              <a href={url(item.href)} class={link}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href={url('/polityka-prywatnosci/')} class={link}>Polityka prywatności</a>
        </li>
      </ul>
    </nav>
  </div>

  <div class="border-t border-line">
    <p class="px-4 py-3 text-center text-xs text-muted">© {year} {SITE.name}. Wszelkie prawa zastrzeżone.</p>
  </div>
</footer>
