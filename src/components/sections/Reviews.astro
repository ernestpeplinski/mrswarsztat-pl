---
import Section from '../ui/Section.astro';
import ReviewCard from '../cards/ReviewCard.astro';
import PrimaryButton from '../ui/PrimaryButton.astro';
import { GOOGLE_RATING, REVIEWS } from '../../config/reviews';
import { SITE } from '../../config/site';

const rating = GOOGLE_RATING.rating.toLocaleString('pl-PL', { minimumFractionDigits: 1 });
---

<Section
  id="opinie"
  eyebrow="Opinie"
  title="Polecają nas klienci z Kościerzyny i okolic"
  intro="Prawdziwe opinie z Google od osób, które zostawiły u nas samochód."
>
  <ul class="grid gap-5 md:grid-cols-3">
    {
      REVIEWS.map((review) => (
        <li>
          <ReviewCard {...review} />
        </li>
      ))
    }
  </ul>

  <div class="mt-10 flex flex-col items-start justify-between gap-5 sm:flex-row sm:items-center">
    <p class="text-lg">
      <strong class="text-2xl font-extrabold text-brand">{rating}/5</strong>
      <span class="text-cream/80">w Google, na podstawie opinii klientów</span>
    </p>
    <div class="flex flex-col gap-3 sm:flex-row">
      <PrimaryButton href={SITE.google.reviewsUrl} variant="secondary" external>Zobacz wszystkie opinie</PrimaryButton>
      <PrimaryButton href={SITE.google.writeReviewUrl} external>Dodaj swoją opinię</PrimaryButton>
    </div>
  </div>
</Section>
