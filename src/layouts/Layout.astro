---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import StickyMobileBar from '../components/layout/StickyMobileBar.astro';
import LocalBusinessSchema from '../components/seo/LocalBusinessSchema.astro';
import { SITE } from '../config/site';

interface Props {
  /** Pełny tytuł <title> (ok. 50–60 znaków, fraza kluczowa na początku). */
  title: string;
  /** Meta description (ok. 140–160 znaków). */
  description: string;
  /** Ścieżka lub URL obrazu OG. Domyślnie obraz z config/site.ts. */
  image?: string;
  imageAlt?: string;
  /** Strony techniczne (np. podziękowania) → noindex. */
  noindex?: boolean;
  ogType?: 'website' | 'article';
}

const {
  title,
  description,
  image = SITE.defaultOgImage,
  imageAlt = `Logo ${SITE.name}`,
  noindex = false,
  ogType = 'website',
} = Astro.props;

// Canonical bez parametrów zapytania; Astro.site pochodzi z astro.config.mjs.
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
const robots = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large, max-snippet:-1';
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalURL} />

    <meta name="theme-color" content="#0b0b0c" />
    <meta name="color-scheme" content="dark" />

    <!-- Favicony -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:alt" content={imageAlt} />

    <!-- Twitter / X (domyślny obraz jest kwadratowy → karta „summary”) -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Globalna encja firmy (AutoRepair) – na każdej stronie. -->
    <LocalBusinessSchema />

    <!--
      Slot na dane strukturalne konkretnej strony, np. na stronie usługi:
        <ServiceSchema slot="head" name="..." description="..." path="/wulkanizacja-koscierzyna/" />
        <FaqSchema slot="head" items={faq} />
    -->
    <slot name="head" />
  </head>

  <body class="flex min-h-dvh flex-col pb-[calc(4.25rem+env(safe-area-inset-bottom))] md:pb-0">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:rounded-md focus:bg-brand focus:px-4 focus:py-2 focus:font-semibold focus:text-white"
    >
      Przejdź do treści
    </a>

    <Header />

    <main id="main" class="flex-1">
      <slot />
    </main>

    <Footer />

    <StickyMobileBar />
  </body>
</html>
