---
import JsonLd from './JsonLd.astro';

/**
 * FAQPage. Przekazuj te same pytania i odpowiedzi, które są widoczne na stronie
 * (treść w JSON-LD musi się zgadzać z treścią na stronie).
 *   <FaqSchema slot="head" items={faq} />
 */
interface Props {
  items: { question: string; answer: string }[];
}

const { items } = Astro.props;

const data = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};
---

<JsonLd data={data} />
